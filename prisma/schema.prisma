generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Usuarios {
  id                  Int                  @id @default(autoincrement())
  nome                String
  email               String               @unique
  senha               String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  usuariosProjetos    UsuariosProjetos[]
  tarefasCriadas      Tarefas[]            @relation("TarefaCriador")
  tarefasResponsaveis Tarefas[]            @relation("TarefaResponsavel")
  comentariosTarefas  ComentariosTarefas[]
  atividadesTarefa    AtividadesTarefa[]
  //papel de admin (RF-81, SPEC-021): só ele administra usuários
  isAdmin             Boolean              @default(false)
  jornadas            Jornadas[]
  ausencias           Ausencias[]
  itensSprint         ItensSprint[]
  apontamentos        Apontamentos[]
  //RF-92 (SPEC-022): quando a senha foi trocada pela última vez; vazio = nunca. O token carrega esse valor
  senhaAlteradaEm     DateTime?
}

model Projetos {
  id               Int                @id @default(autoincrement())
  nome             String
  descricao        String?
  idStatus         Int
  status           StatusProjeto      @relation(fields: [idStatus], references: [id])
  data_inicio      DateTime?
  data_final       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  usuariosProjetos UsuariosProjetos[]
  tarefas          Tarefas[]
}

model UsuariosProjetos {
  id        Int      @id @default(autoincrement())
  idUsuario Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  usuario   Usuarios @relation(fields: [idUsuario], references: [id])
  idProjeto Int
  projeto   Projetos @relation(fields: [idProjeto], references: [id])

  @@unique([idUsuario, idProjeto])
}

model Tarefas {
  id                   Int                  @id @default(autoincrement())
  nome                 String
  descricao            String?
  idStatus             Int
  status               StatusTarefa         @relation(fields: [idStatus], references: [id])
  prioridade           String
  data_inicio          DateTime?
  data_final           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  idUsuarioResponsavel Int?
  usuarioResponsavel   Usuarios?            @relation("TarefaResponsavel", fields: [idUsuarioResponsavel], references: [id])
  idUsuarioCriador     Int
  usuarioCriador       Usuarios             @relation("TarefaCriador", fields: [idUsuarioCriador], references: [id])
  idProjeto            Int
  projeto              Projetos             @relation(fields: [idProjeto], references: [id])
  labelsTarefas        LabelsTarefas[]
  comentariosTarefas   ComentariosTarefas[]
  atividadesTarefa     AtividadesTarefa[]
  idTarefaPai          Int?
  tarefaPai            Tarefas?             @relation("SubTarefas", fields: [idTarefaPai], references: [id], onDelete: Restrict)
  subtarefas           Tarefas[]            @relation("SubTarefas")
  // SPEC-024 (RF-108): refinamento, todos opcionais; horas em minutos inteiros
  minutosEstimados     Int?
  minutosBuffer        Int?
  issueExterna         String?
  solicitante          String?
  itensSprint          ItensSprint[]

  @@index([idTarefaPai])
}

model ComentariosTarefas {
  id         Int      @id @default(autoincrement())
  comentario String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  idTarefa   Int
  tarefa     Tarefas  @relation(fields: [idTarefa], references: [id])
  idUsuario  Int
  usuario    Usuarios @relation(fields: [idUsuario], references: [id])
}

model Labels {
  id            Int             @id @default(autoincrement())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  nome          String
  cor           String?
  labelsTarefas LabelsTarefas[]
}

model LabelsTarefas {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  idLabel   Int
  label     Labels   @relation(fields: [idLabel], references: [id])
  idTarefa  Int
  tarefa    Tarefas  @relation(fields: [idTarefa], references: [id])

  @@unique([idLabel, idTarefa])
}

model StatusProjeto {
  id        Int        @id @default(autoincrement())
  nome      String
  cor       String?
  ordem     Int
  isFinal   Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  projetos  Projetos[]
}

model StatusTarefa {
  id        Int       @id @default(autoincrement())
  nome      String
  cor       String?
  ordem     Int
  isFinal   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tarefas   Tarefas[]
}

// Histórico da tarefa (RF-53): uma linha por campo que mudou num PATCH; imutável (sem updatedAt).
// Autor por id com SET NULL + nome guardado; ids de valor sem FK (SPEC-016, D-1/D-2).
model AtividadesTarefa {
  id            Int       @id @default(autoincrement())
  idTarefa      Int
  tarefa        Tarefas   @relation(fields: [idTarefa], references: [id])
  idUsuario     Int?
  usuario       Usuarios? @relation(fields: [idUsuario], references: [id], onDelete: SetNull)
  nomeUsuario   String
  campo         String
  valorAnterior String?
  valorNovo     String?
  idAnterior    Int?
  idNovo        Int?
  createdAt     DateTime  @default(now())

  @@index([idTarefa, createdAt])
}

// SPEC-023 (RF-101): jornada por dev, com vigência; minutos por dia da semana (0..1440)
model Jornadas {
  id        Int      @id @default(autoincrement())
  idUsuario Int
  usuario   Usuarios @relation(fields: [idUsuario], references: [id], onDelete: Restrict)
  vigencia  DateTime
  seg       Int
  ter       Int
  qua       Int
  qui       Int
  sex       Int
  sab       Int
  dom       Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([idUsuario, vigencia])
}

// SPEC-023 (RF-102): feriado do time; minutosDescontados null = dia inteiro
model Feriados {
  id                 Int      @id @default(autoincrement())
  data               DateTime @unique
  nome               String
  minutosDescontados Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// SPEC-023 (RF-104): ausência por dev; minutosPorDia null = dia inteiro
model Ausencias {
  id            Int      @id @default(autoincrement())
  idUsuario     Int
  usuario       Usuarios @relation(fields: [idUsuario], references: [id], onDelete: Restrict)
  tipo          String
  dataInicio    DateTime
  dataFim       DateTime
  minutosPorDia Int?
  observacao    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([idUsuario, dataInicio])
}

// SPEC-024 (RF-109): sprint do time; status Planejamento | Ativa | Fechada
model Sprints {
  id         Int           @id @default(autoincrement())
  nome       String
  dataInicio DateTime
  dataFim    DateTime
  status     String        @default("Planejamento")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  itens      ItensSprint[]
}

// SPEC-024 (RF-110): uma linha na fila de um dev; de tarefa (idTarefa) ou avulsa (nome + minutosAvulsos).
// evolucao, bloqueio, observacao e dataEntregaReal são da SPEC-025 (criados aqui, D-8)
model ItensSprint {
  id                     Int           @id @default(autoincrement())
  idSprint               Int
  sprint                 Sprints       @relation(fields: [idSprint], references: [id], onDelete: Cascade)
  idTarefa               Int?
  tarefa                 Tarefas?      @relation(fields: [idTarefa], references: [id], onDelete: Restrict)
  nome                   String?
  minutosAvulsos         Int?
  recorrente             Boolean       @default(false)
  idUsuario              Int
  usuario                Usuarios      @relation(fields: [idUsuario], references: [id], onDelete: Restrict)
  ordem                  Int
  naoPrevista            Boolean       @default(false)
  inicioPrevisto         DateTime?
  entregaPrevista        DateTime?
  minutosPlanejadosFixos Int?
  idItemOrigem           Int?
  itemOrigem             ItensSprint?  @relation("Transbordo", fields: [idItemOrigem], references: [id], onDelete: SetNull)
  derivados              ItensSprint[] @relation("Transbordo")
  apontamentos           Apontamentos[]
  evolucao               Int           @default(0)
  bloqueio               String?
  observacao             String?
  dataEntregaReal        DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([idSprint, idUsuario, ordem])
  @@index([idTarefa])
}

// SPEC-026 (RF-128): apontamento de horas; início e fim em minutos do dia; item opcional (sem item exige observação)
model Apontamentos {
  id           Int          @id @default(autoincrement())
  idUsuario    Int
  usuario      Usuarios     @relation(fields: [idUsuario], references: [id], onDelete: Restrict)
  data         DateTime
  inicioMin    Int
  fimMin       Int
  idItemSprint Int?
  item         ItensSprint? @relation(fields: [idItemSprint], references: [id], onDelete: SetNull)
  observacao   String?
  foraDaSprint Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([idUsuario, data])
  @@index([idItemSprint])
}
