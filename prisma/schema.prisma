generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Usuarios {
  id                  Int                  @id @default(autoincrement())
  nome                String
  email               String               @unique
  senha               String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  usuariosProjetos    UsuariosProjetos[]
  tarefasCriadas      Tarefas[]            @relation("TarefaCriador")
  tarefasResponsaveis Tarefas[]            @relation("TarefaResponsavel")
  comentariosTarefas  ComentariosTarefas[]
  atividadesTarefa    AtividadesTarefa[]
}

model Projetos {
  id               Int                @id @default(autoincrement())
  nome             String
  descricao        String?
  idStatus         Int
  status           StatusProjeto      @relation(fields: [idStatus], references: [id])
  data_inicio      DateTime?
  data_final       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  usuariosProjetos UsuariosProjetos[]
  tarefas          Tarefas[]
}

model UsuariosProjetos {
  id        Int      @id @default(autoincrement())
  idUsuario Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  usuario   Usuarios @relation(fields: [idUsuario], references: [id])
  idProjeto Int
  projeto   Projetos @relation(fields: [idProjeto], references: [id])

  @@unique([idUsuario, idProjeto])
}

model Tarefas {
  id                   Int                  @id @default(autoincrement())
  nome                 String
  descricao            String?
  idStatus             Int
  status               StatusTarefa         @relation(fields: [idStatus], references: [id])
  prioridade           String
  data_inicio          DateTime?
  data_final           DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  idUsuarioResponsavel Int?
  usuarioResponsavel   Usuarios?            @relation("TarefaResponsavel", fields: [idUsuarioResponsavel], references: [id])
  idUsuarioCriador     Int
  usuarioCriador       Usuarios             @relation("TarefaCriador", fields: [idUsuarioCriador], references: [id])
  idProjeto            Int
  projeto              Projetos             @relation(fields: [idProjeto], references: [id])
  labelsTarefas        LabelsTarefas[]
  comentariosTarefas   ComentariosTarefas[]
  atividadesTarefa     AtividadesTarefa[]
  idTarefaPai          Int?
  tarefaPai            Tarefas?             @relation("SubTarefas", fields: [idTarefaPai], references: [id], onDelete: Restrict)
  subtarefas           Tarefas[]            @relation("SubTarefas")

  @@index([idTarefaPai])
}

model ComentariosTarefas {
  id         Int      @id @default(autoincrement())
  comentario String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  idTarefa   Int
  tarefa     Tarefas  @relation(fields: [idTarefa], references: [id])
  idUsuario  Int
  usuario    Usuarios @relation(fields: [idUsuario], references: [id])
}

model Labels {
  id            Int             @id @default(autoincrement())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  nome          String
  labelsTarefas LabelsTarefas[]
}

model LabelsTarefas {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  idLabel   Int
  label     Labels   @relation(fields: [idLabel], references: [id])
  idTarefa  Int
  tarefa    Tarefas  @relation(fields: [idTarefa], references: [id])

  @@unique([idLabel, idTarefa])
}

model StatusProjeto {
  id        Int        @id @default(autoincrement())
  nome      String
  cor       String?
  ordem     Int
  isFinal   Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  projetos  Projetos[]
}

model StatusTarefa {
  id        Int       @id @default(autoincrement())
  nome      String
  cor       String?
  ordem     Int
  isFinal   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tarefas   Tarefas[]
}

// Histórico da tarefa (RF-53): uma linha por campo que mudou num PATCH; imutável (sem updatedAt).
// Autor por id com SET NULL + nome guardado; ids de valor sem FK (SPEC-016, D-1/D-2).
model AtividadesTarefa {
  id            Int       @id @default(autoincrement())
  idTarefa      Int
  tarefa        Tarefas   @relation(fields: [idTarefa], references: [id])
  idUsuario     Int?
  usuario       Usuarios? @relation(fields: [idUsuario], references: [id], onDelete: SetNull)
  nomeUsuario   String
  campo         String
  valorAnterior String?
  valorNovo     String?
  idAnterior    Int?
  idNovo        Int?
  createdAt     DateTime  @default(now())

  @@index([idTarefa, createdAt])
}
