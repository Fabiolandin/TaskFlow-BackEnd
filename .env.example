# banco SQLite (RF-95): relativo à pasta do backend, o mesmo para a API, o npm run admin e as migrations
DATABASE_URL="file:./prisma/dev.db"
JWT_SECRET="change-this-development-secret"
PORT=3000
# origens do front que podem chamar a API, separadas por vírgula (RF-84)
CORS_ORIGIN="http://localhost:5173"
# quantos proxies há na frente da API (RF-88): 0 ou ausente = nenhum; 1 = atrás de um proxy (nginx, Render, Railway...)
TRUST_PROXY=0
